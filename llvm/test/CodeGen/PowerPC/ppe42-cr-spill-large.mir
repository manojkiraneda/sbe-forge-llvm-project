# RUN: llc -mtriple=powerpc-none-eabi -mcpu=ppe42 -run-pass=ppc-ppe42-cr-spill -verify-machineinstrs %s -o %t.mir
# RUN: FileCheck %s < %t.mir
# RUN: llc -mtriple=powerpc-none-eabi -mcpu=ppe42 -start-before=phi-node-elimination -verify-machineinstrs -filetype=obj %t.mir -o %t.o

--- |
  define void @ten_branches(i32 %a, i32 %b) optsize { ret void }
  define void @seventeen_branches(i32 %a, i32 %b) optsize { ret void }
  define void @long_live_range(i32 %a, i32 %b) optsize { ret void }
...
---
name: ten_branches
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: ten_branches
  bb.0:
    successors: %bb.1, %bb.19
    liveins: $r3, $r4
    %0:gprc = COPY $r3
    %1:gprc = COPY $r4
    %2:crrc = CMPLWI %0, 1
    BCC 76, %2, %bb.19
    B %bb.1
  bb.1:
    successors: %bb.2, %bb.19
    %3:crrc = CMPLWI %1, 2
    BCC 76, killed %3, %bb.19
    B %bb.2
  bb.2:
    successors: %bb.3, %bb.19
    ; CHECK: bb.2:
    ; CHECK: %[[CR:[0-9]+]]:crrc = CMPLWI %0, 1
    ; CHECK-NEXT: BCC 76, killed %[[CR]],
    BCC 76, %2, %bb.19
    B %bb.3
  bb.3:
    successors: %bb.4, %bb.19
    %4:crrc = CMPLWI %1, 3
    BCC 76, killed %4, %bb.19
    B %bb.4
  bb.4:
    successors: %bb.5, %bb.19
    BCC 76, %2, %bb.19
    B %bb.5
  bb.5:
    successors: %bb.6, %bb.19
    %5:crrc = CMPLWI %1, 4
    BCC 76, killed %5, %bb.19
    B %bb.6
  bb.6:
    successors: %bb.7, %bb.19
    BCC 76, %2, %bb.19
    B %bb.7
  bb.7:
    successors: %bb.8, %bb.19
    %6:crrc = CMPLWI %1, 5
    BCC 76, killed %6, %bb.19
    B %bb.8
  bb.8:
    successors: %bb.9, %bb.19
    BCC 76, %2, %bb.19
    B %bb.9
  bb.9:
    successors: %bb.10, %bb.19
    %7:crrc = CMPLWI %1, 6
    BCC 76, killed %7, %bb.19
    B %bb.10
  bb.10:
    successors: %bb.11, %bb.19
    BCC 76, %2, %bb.19
    B %bb.11
  bb.11:
    successors: %bb.12, %bb.19
    %8:crrc = CMPLWI %1, 7
    BCC 76, killed %8, %bb.19
    B %bb.12
  bb.12:
    successors: %bb.13, %bb.19
    BCC 76, %2, %bb.19
    B %bb.13
  bb.13:
    successors: %bb.14, %bb.19
    %9:crrc = CMPLWI %1, 8
    BCC 76, killed %9, %bb.19
    B %bb.14
  bb.14:
    successors: %bb.15, %bb.19
    BCC 76, %2, %bb.19
    B %bb.15
  bb.15:
    successors: %bb.16, %bb.19
    %10:crrc = CMPLWI %1, 9
    BCC 76, killed %10, %bb.19
    B %bb.16
  bb.16:
    successors: %bb.17, %bb.19
    BCC 76, %2, %bb.19
    B %bb.17
  bb.17:
    successors: %bb.18, %bb.19
    %11:crrc = CMPLWI %1, 10
    BCC 76, killed %11, %bb.19
    B %bb.18
  bb.18:
    successors: %bb.19
    BCC 76, %2, %bb.19
  bb.19:
    BLR implicit $lr, implicit undef $rm
...
