# RUN: llc -mtriple=powerpc-unknown-elf -mcpu=ppe42 -run-pass=ppc-pre-emit-peephole -verify-machineinstrs -o - %s | FileCheck %s

--- |
  @record = global [4 x i32] zeroinitializer, align 8
  define void @adjacent(ptr %p) { ret void }
  define void @aligned_global(ptr %p) { ret void }
  define void @offset_global(ptr %p) { ret void }
  define void @unaligned_stack_pair(ptr %p) { ret void }
  define void @same_reg(ptr %p) { ret void }
  define void @misaligned(ptr %p) { ret void }
  define void @volatile_store(ptr %p) { ret void }
  define void @reverse_pair(ptr %p) { ret void }
  define void @derived_base(ptr %p) { ret void }
  define void @changed_base(ptr %p) { ret void }
  define void @derived_unaligned(ptr %p) { ret void }
  define void @symbolic_sda(ptr %p) { ret void }
  define void @separated_derived_base(ptr %p) { ret void }
  define void @separated_later_value_changed(ptr %p) { ret void }
  define void @separated_by_load(ptr %p) { ret void }
...
---
name: adjacent
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6, $r9, $r10
    ; CHECK-LABEL: name: adjacent
    ; CHECK: STVD ${{[^,]+}}, 8, $r6
    ; CHECK-NOT: STW
    STW $r9, 8, $r6 :: (store (s32) into %ir.p + 8, align 8)
    STW $r10, 12, $r6 :: (store (s32) into %ir.p + 12, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
name: aligned_global
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6, $r9, $r10
    ; The global is only word-aligned, so the memory interface may reject STVD.
    ; CHECK-LABEL: name: aligned_global
    ; CHECK: STW $r9, 0, $r6
    ; CHECK: STW $r10, 4, $r6
    STW $r9, 0, $r6 :: (store (s32) into @record, align 4)
    STW $r10, 4, $r6 :: (store (s32) into @record + 4, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
name: offset_global
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6, $r9, $r10
    ; A four-byte offset into an eight-byte-aligned global is not safe either.
    ; CHECK-LABEL: name: offset_global
    ; CHECK: STW $r9, 0, $r6
    ; CHECK: STW $r10, 4, $r6
    STW $r9, 0, $r6 :: (store (s32) into @record + 4, align 4)
    STW $r10, 4, $r6 :: (store (s32) into @record + 8, align 8)
    BLR implicit $lr, implicit undef $rm
...
---
name: same_reg
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6, $r9
    ; CHECK-LABEL: name: same_reg
    ; CHECK: STW $r9, 8, $r6
    ; CHECK: STW $r9, 12, $r6
    STW $r9, 8, $r6 :: (store (s32) into %ir.p + 8, align 8)
    STW $r9, 12, $r6 :: (store (s32) into %ir.p + 12, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
name: unaligned_stack_pair
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1, $r3, $r4
    ; The QME fault was STVD d3, 36(r1): this address is only word-aligned.
    ; CHECK-LABEL: name: unaligned_stack_pair
    ; CHECK: STW $r3, 36, $r1
    ; CHECK: STW $r4, 40, $r1
    STW $r3, 36, $r1 :: (store (s32) into %ir.p + 36, align 4)
    STW $r4, 40, $r1 :: (store (s32) into %ir.p + 40, align 8)
    BLR implicit $lr, implicit undef $rm
...
---
name: misaligned
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6, $r9, $r10
    ; CHECK-LABEL: name: misaligned
    ; CHECK: STW $r9, 4, $r6
    ; CHECK: STW $r10, 8, $r6
    STW $r9, 4, $r6 :: (store (s32) into %ir.p + 4, align 2)
    STW $r10, 8, $r6 :: (store (s32) into %ir.p + 8, align 8)
    BLR implicit $lr, implicit undef $rm
...
---
name: volatile_store
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6, $r9, $r10
    ; CHECK-LABEL: name: volatile_store
    ; CHECK: STW $r9, 8, $r6
    ; CHECK: STW $r10, 12, $r6
    STW $r9, 8, $r6 :: (volatile store (s32) into %ir.p + 8, align 8)
    STW $r10, 12, $r6 :: (store (s32) into %ir.p + 12, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
name: reverse_pair
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6, $r3, $r4
    ; CHECK-LABEL: name: reverse_pair
    ; CHECK: STVD ${{[^,]+}}, 8, $r6
    ; CHECK-NOT: STW
    STW $r4, 12, $r6 :: (store (s32) into %ir.p + 12, align 4)
    STW $r3, 8, $r6 :: (store (s32) into %ir.p + 8, align 8)
    BLR implicit $lr, implicit undef $rm
...
---
name: derived_base
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r13, $r1, $r3, $r4
    ; CHECK-LABEL: name: derived_base
    ; CHECK: $r5 = ADDI $r13, 564
    ; CHECK: STVD ${{[^,]+}}, 564, $r13
    ; CHECK-NOT: STW $r4, 4, $r5
    ; CHECK-NOT: STW $r3, 564, $r13
    $r5 = ADDI $r13, 564
    STW $r5, 92, $r1 :: (store (s32) into %ir.p + 92, align 4)
    STW $r4, 4, $r5 :: (store (s32) into %ir.p + 4, align 4)
    STW $r3, 564, $r13 :: (store (s32) into %ir.p, align 8)
    BLR implicit $lr, implicit undef $rm
...
---
name: changed_base
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6, $r3, $r4
    ; CHECK-LABEL: name: changed_base
    ; CHECK: STW $r4, 4, $r5
    ; CHECK: STW $r3, 564, $r6
    $r5 = ADDI $r6, 564
    $r6 = ADDI $r6, 4
    STW $r4, 4, $r5 :: (store (s32) into %ir.p + 4, align 4)
    STW $r3, 564, $r6 :: (store (s32) into %ir.p, align 8)
    BLR implicit $lr, implicit undef $rm
...
---
name: derived_unaligned
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r13, $r3, $r4
    ; CHECK-LABEL: name: derived_unaligned
    ; CHECK: STW $r4, 4, $r5
    ; CHECK: STW $r3, 564, $r13
    $r5 = ADDI $r13, 564
    STW $r4, 4, $r5 :: (store (s32) into %ir.p + 4, align 4)
    STW $r3, 564, $r13 :: (store (s32) into %ir.p, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
name: symbolic_sda
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r4
    ; CHECK-LABEL: name: symbolic_sda
    ; CHECK: STVD ${{[^,]+}}, target-flags(ppc-lo) @record, $r5
    ; CHECK-NOT: STW
    $r5 = LIS target-flags(ppc-ha) @record
    $r6 = LA $r5, target-flags(ppc-lo) @record
    STW $r4, 4, $r6 :: (store (s32) into @record + 4, align 4)
    STW $r3, target-flags(ppc-lo) @record, $r5 :: (store (s32) into @record, align 8)
    BLR implicit $lr, implicit undef $rm
...
---
name: separated_derived_base
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r13, $r3, $r4
    ; CHECK-LABEL: name: separated_derived_base
    ; CHECK: STVD ${{[^,]+}}, 564, $r13
    ; CHECK-NEXT: $r3 = LI 1
    ; CHECK-NOT: STW $r4, 4, $r5
    $r5 = ADDI $r13, 564
    STW $r3, 564, $r13 :: (store (s32) into %ir.p, align 8)
    $r3 = LI 1
    STW $r4, 4, $r5 :: (store (s32) into %ir.p + 4, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
name: separated_later_value_changed
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6, $r9
    ; CHECK-LABEL: name: separated_later_value_changed
    ; CHECK: STW $r9, 8, $r6
    ; CHECK: $r10 = LI 1
    ; CHECK: STW $r10, 12, $r6
    STW $r9, 8, $r6 :: (store (s32) into %ir.p + 8, align 8)
    $r10 = LI 1
    STW $r10, 12, $r6 :: (store (s32) into %ir.p + 12, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
name: separated_by_load
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6, $r9, $r10
    ; CHECK-LABEL: name: separated_by_load
    ; CHECK: STW $r9, 8, $r6
    ; CHECK: $r3 = LWZ 8, $r6
    ; CHECK: STW $r10, 12, $r6
    STW $r9, 8, $r6 :: (store (s32) into %ir.p + 8, align 8)
    $r3 = LWZ 8, $r6 :: (load (s32) from %ir.p + 8, align 8)
    STW $r10, 12, $r6 :: (store (s32) into %ir.p + 12, align 4)
    BLR implicit $lr, implicit undef $rm
...
