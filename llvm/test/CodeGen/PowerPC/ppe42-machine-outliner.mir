# RUN: llc -mtriple=powerpc-none-eabi -mcpu=ppe42 -run-pass=machine-outliner -verify-machineinstrs %s -o %t
# RUN: FileCheck %s --check-prefix=TAIL < %t
# RUN: FileCheck %s --check-prefix=PLAIN < %t
# RUN: FileCheck %s --check-prefix=SAFE < %t

--- |
  declare void @trace(i32, i32, i32, i32)
  define void @tail_calls() optsize { ret void }
  define void @straight_line() optsize { ret void }
  define void @live_lr() optsize { ret void }
  define void @named_section() optsize section ".vectors" { ret void }
...
---
name: tail_calls
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1, $lr
    ; TAIL-LABEL: name: tail_calls
    ; TAIL: BL @OUTLINED_FUNCTION_[[N:[0-9]+]], csr_svr432
    ; TAIL: BL @OUTLINED_FUNCTION_[[N]], csr_svr432
    ; TAIL: BL @OUTLINED_FUNCTION_[[N]], csr_svr432
    ; TAIL: LSKU
    ; TAIL: BLR
    $r1 = frame-setup STSKU $r1, -32, $r1, implicit $lr
    $r3 = LI 1
    $r4 = LI 0
    $r5 = LI 0
    $r6 = LI 0
    BL @trace, csr_svr432, implicit-def dead $lr, implicit undef $rm, implicit $r3, implicit $r4, implicit $r5, implicit $r6
    $r3 = LI 2
    $r4 = LI 0
    $r5 = LI 0
    $r6 = LI 0
    BL @trace, csr_svr432, implicit-def dead $lr, implicit undef $rm, implicit $r3, implicit $r4, implicit $r5, implicit $r6
    $r3 = LI 3
    $r4 = LI 0
    $r5 = LI 0
    $r6 = LI 0
    BL @trace, csr_svr432, implicit-def dead $lr, implicit undef $rm, implicit $r3, implicit $r4, implicit $r5, implicit $r6
    $r1 = frame-destroy LSKU 32, $r1, implicit-def $lr
    BLR implicit $lr, implicit undef $rm
...
---
name: straight_line
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1, $lr, $r7, $r13
    ; PLAIN-LABEL: name: straight_line
    ; PLAIN: BL @OUTLINED_FUNCTION_[[N:[0-9]+]]
    ; PLAIN: BL @OUTLINED_FUNCTION_[[N]]
    ; PLAIN: BL @OUTLINED_FUNCTION_[[N]]
    ; PLAIN: LSKU
    $r1 = frame-setup STSKU $r1, -32, $r1, implicit $lr
    $r3 = LIS 256
    $r3 = ORI $r3, 42
    $r4 = RLWINM $r7, 10, 16, 21
    $r3 = OR $r3, $r4
    STW $r3, 0, $r13
    $r3 = LIS 256
    $r3 = ORI $r3, 42
    $r4 = RLWINM $r7, 10, 16, 21
    $r3 = OR $r3, $r4
    STW $r3, 0, $r13
    $r3 = LIS 256
    $r3 = ORI $r3, 42
    $r4 = RLWINM $r7, 10, 16, 21
    $r3 = OR $r3, $r4
    STW $r3, 0, $r13
    $r1 = frame-destroy LSKU 32, $r1, implicit-def $lr
    BLR implicit $lr, implicit undef $rm
...
---
name: live_lr
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $lr, $r7, $r13
    ; SAFE-LABEL: name: live_lr
    ; SAFE-NOT: OUTLINED_FUNCTION
    ; SAFE: BLR
    $r3 = LIS 256
    $r3 = ORI $r3, 42
    $r4 = RLWINM $r7, 10, 16, 21
    $r3 = OR $r3, $r4
    STW $r3, 0, $r13
    $r3 = LIS 256
    $r3 = ORI $r3, 42
    $r4 = RLWINM $r7, 10, 16, 21
    $r3 = OR $r3, $r4
    STW $r3, 0, $r13
    $r3 = LIS 256
    $r3 = ORI $r3, 42
    $r4 = RLWINM $r7, 10, 16, 21
    $r3 = OR $r3, $r4
    STW $r3, 0, $r13
    BLR implicit $lr, implicit undef $rm
...
---
name: named_section
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r1, $lr
    ; SAFE-LABEL: name: named_section
    ; SAFE-NOT: OUTLINED_FUNCTION
    ; SAFE: BLR
    $r1 = frame-setup STSKU $r1, -32, $r1, implicit $lr
    $r3 = LI 1
    $r4 = LI 0
    $r5 = LI 0
    $r6 = LI 0
    BL @trace, csr_svr432, implicit-def dead $lr, implicit undef $rm, implicit $r3, implicit $r4, implicit $r5, implicit $r6
    $r3 = LI 2
    $r4 = LI 0
    $r5 = LI 0
    $r6 = LI 0
    BL @trace, csr_svr432, implicit-def dead $lr, implicit undef $rm, implicit $r3, implicit $r4, implicit $r5, implicit $r6
    $r3 = LI 3
    $r4 = LI 0
    $r5 = LI 0
    $r6 = LI 0
    BL @trace, csr_svr432, implicit-def dead $lr, implicit undef $rm, implicit $r3, implicit $r4, implicit $r5, implicit $r6
    $r1 = frame-destroy LSKU 32, $r1, implicit-def $lr
    BLR implicit $lr, implicit undef $rm
...

# TAIL: name: OUTLINED_FUNCTION_[[N]]
# TAIL-NOT: STSKU
# TAIL: $r4 = LI 0
# TAIL: $r5 = LI 0
# TAIL: $r6 = LI 0
# TAIL: B @trace
# TAIL-NOT: BLR
# TAIL: ...
# PLAIN: name: OUTLINED_FUNCTION_[[N]]
# PLAIN-NOT: STSKU
# PLAIN: LIS 256
# PLAIN: STW
# PLAIN: BLR
