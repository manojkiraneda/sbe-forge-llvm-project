---
name: live_reload
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
body: |
  ; CHECK-LABEL: name: live_reload
  ; CHECK: STW
  ; CHECK: LWZ
  ; CHECK: $r5 = OR $r4, $r3
  bb.0:
    liveins: $r0, $r4
    $r3 = LIS 2048
    $r3 = ORI $r3, 32
    STW $r3, 0, %stack.0 :: (store (s32) into %stack.0)
    $r3 = LWZ 0, %stack.0 :: (load (s32) from %stack.0)
    $r5 = OR $r4, $r3
    BLR implicit $lr, implicit undef $rm, implicit $r5, implicit $r3
...
---
name: unknown_store
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
body: |
  ; CHECK-LABEL: name: unknown_store
  ; CHECK: STW
  ; CHECK: LWZ
  ; CHECK: $r5 = OR $r4, killed $r3
  bb.0:
    liveins: $r0, $r4
    $r3 = COPY $r4
    STW $r3, 0, %stack.0 :: (store (s32) into %stack.0)
    $r3 = LWZ 0, %stack.0 :: (load (s32) from %stack.0)
    $r5 = OR $r4, killed $r3
    BLR implicit $lr, implicit undef $rm, implicit $r5
...
---
name: local_object
tracksRegLiveness: true
stack:
