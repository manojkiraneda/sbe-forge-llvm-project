# RUN: llc -mtriple=powerpc-unknown-elf -mcpu=ppe42 -run-pass=ppc-ppe42-store-pairs -verify-machineinstrs -o - %s | FileCheck %s

--- |
  define void @aligned(ptr %p) #0 { ret void }
  define void @reverse_order(ptr %p) #0 { ret void }
  define void @interleaved(ptr %p) #0 { ret void }
  define void @unaligned(ptr %p) #0 { ret void }
  define void @volatile_load(ptr %p) #0 { ret void }
  define void @intervening_use(ptr %p) #0 { ret void }
  define void @stack_pair() #0 {
    %slot = alloca i64, align 8
    ret void
  }
  attributes #0 = { optsize }
...
---
name: aligned
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6
    ; CHECK-LABEL: name: aligned
    ; CHECK: %[[PAIR:[0-9]+]]:vdrc = LVD 8, %
    ; CHECK: STW %[[PAIR]].sub_gpr_hi, 16,
    ; CHECK: STW %[[PAIR]].sub_gpr_lo, 20,
    ; CHECK-NOT: LWZ
    %0:gprc_nor0 = COPY $r6
    %1:gprc = LWZ 8, %0 :: (load (s32) from %ir.p + 8, align 8)
    %2:gprc = LWZ 12, %0 :: (load (s32) from %ir.p + 12, align 4)
    STW %1, 16, %0 :: (store (s32) into %ir.p + 16, align 4)
    STW %2, 20, %0 :: (store (s32) into %ir.p + 20, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
name: reverse_order
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6
    ; CHECK-LABEL: name: reverse_order
    ; CHECK: LVD 8,
    ; CHECK-NOT: LWZ
    %0:gprc_nor0 = COPY $r6
    %1:gprc = LWZ 12, %0 :: (load (s32) from %ir.p + 12, align 4)
    %2:gprc = LWZ 8, %0 :: (load (s32) from %ir.p + 8, align 8)
    STW %2, 16, %0 :: (store (s32) into %ir.p + 16, align 4)
    STW %1, 20, %0 :: (store (s32) into %ir.p + 20, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
name: interleaved
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6
    ; CHECK-LABEL: name: interleaved
    ; CHECK: LVD 8,
    ; CHECK: LI 7
    ; CHECK-NOT: LWZ
    %0:gprc_nor0 = COPY $r6
    %1:gprc = LWZ 8, %0 :: (load (s32) from %ir.p + 8, align 8)
    %3:gprc = LI 7
    %2:gprc = LWZ 12, %0 :: (load (s32) from %ir.p + 12, align 4)
    STW %1, 16, %0 :: (store (s32) into %ir.p + 16, align 4)
    STW %2, 20, %0 :: (store (s32) into %ir.p + 20, align 4)
    $r3 = COPY %3
    BLR implicit $lr, implicit undef $rm
...
---
name: unaligned
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6
    ; CHECK-LABEL: name: unaligned
    ; CHECK: LWZ 4,
    ; CHECK: LWZ 8,
    ; CHECK-NOT: LVD
    %0:gprc_nor0 = COPY $r6
    %1:gprc = LWZ 4, %0 :: (load (s32) from %ir.p + 4, align 4)
    %2:gprc = LWZ 8, %0 :: (load (s32) from %ir.p + 8, align 8)
    STW %1, 16, %0 :: (store (s32) into %ir.p + 16, align 4)
    STW %2, 20, %0 :: (store (s32) into %ir.p + 20, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
name: volatile_load
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6
    ; CHECK-LABEL: name: volatile_load
    ; CHECK: LWZ 8,
    ; CHECK: LWZ 12,
    ; CHECK-NOT: LVD
    %0:gprc_nor0 = COPY $r6
    %1:gprc = LWZ 8, %0 :: (volatile load (s32) from %ir.p + 8, align 8)
    %2:gprc = LWZ 12, %0 :: (load (s32) from %ir.p + 12, align 4)
    STW %1, 16, %0 :: (store (s32) into %ir.p + 16, align 4)
    STW %2, 20, %0 :: (store (s32) into %ir.p + 20, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
name: intervening_use
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6
    ; CHECK-LABEL: name: intervening_use
    ; CHECK: LWZ 8,
    ; CHECK: $r3 = COPY %1
    ; CHECK: LWZ 12,
    ; CHECK-NOT: LVD
    %0:gprc_nor0 = COPY $r6
    %1:gprc = LWZ 8, %0 :: (load (s32) from %ir.p + 8, align 8)
    $r3 = COPY %1
    %2:gprc = LWZ 12, %0 :: (load (s32) from %ir.p + 12, align 4)
    STW %2, 20, %0 :: (store (s32) into %ir.p + 20, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
name: stack_pair
tracksRegLiveness: true
stack:
  - { id: 0, name: slot, type: default, offset: 0, size: 8, alignment: 8 }
body: |
  bb.0:
    ; CHECK-LABEL: name: stack_pair
    ; CHECK: LVD 0, %stack.0.slot
    ; CHECK-NOT: LWZ
    %0:gprc = LWZ 0, %stack.0.slot :: (load (s32) from %ir.slot, align 8)
    %1:gprc = LWZ 4, %stack.0.slot :: (load (s32) from %ir.slot + 4, align 4)
    $r3 = COPY %0
    $r4 = COPY %1
    BLR implicit $lr, implicit undef $rm
...
