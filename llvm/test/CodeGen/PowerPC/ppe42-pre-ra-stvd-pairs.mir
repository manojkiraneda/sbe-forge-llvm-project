# RUN: llc -mtriple=powerpc-unknown-elf -mcpu=ppe42 -run-pass=ppc-ppe42-store-pairs -verify-machineinstrs -o - %s | FileCheck %s

--- |
  define void @pair(ptr %p) #0 { ret void }
  define void @shared_word(ptr %p) #0 { ret void }
  define void @unaligned(ptr %p) #0 { ret void }
  define void @reverse_order(ptr %p) #0 { ret void }
  define void @interleaved_reg_op(ptr %p) #0 { ret void }
  define void @repeated_zero(ptr %p) #0 { ret void }
  define void @single_same_word(ptr %p) #0 { ret void }
  attributes #0 = { optsize }
...
---
name: pair
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r4, $r6
    ; CHECK-LABEL: name: pair
    ; CHECK: REG_SEQUENCE {{.*}}, %subreg.sub_gpr_hi, {{.*}}, %subreg.sub_gpr_lo
    ; CHECK: STVD
    ; CHECK-NOT: STW
    %0:gprc = COPY $r3
    %1:gprc = COPY $r4
    %2:gprc_nor0 = COPY $r6
    STW %0, 8, %2 :: (store (s32) into %ir.p + 8, align 8)
    STW %1, 12, %2 :: (store (s32) into %ir.p + 12, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
name: shared_word
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r4, $r6
    ; CHECK-LABEL: name: shared_word
    ; CHECK: STW {{.*}}, 8, {{.*}}
    ; CHECK: STW {{.*}}, 12, {{.*}}
    %0:gprc = COPY $r3
    %1:gprc = COPY $r4
    %2:gprc_nor0 = COPY $r6
    STW %0, 8, %2 :: (store (s32) into %ir.p + 8, align 8)
    STW %1, 12, %2 :: (store (s32) into %ir.p + 12, align 4)
    STW %0, 20, %2 :: (store (s32) into %ir.p + 20, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
name: unaligned
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r4, $r6
    ; CHECK-LABEL: name: unaligned
    ; CHECK: STW {{.*}}, 4, {{.*}}
    ; CHECK: STW {{.*}}, 8, {{.*}}
    %0:gprc = COPY $r3
    %1:gprc = COPY $r4
    %2:gprc_nor0 = COPY $r6
    STW %0, 4, %2 :: (store (s32) into %ir.p + 4, align 4)
    STW %1, 8, %2 :: (store (s32) into %ir.p + 8, align 8)
    BLR implicit $lr, implicit undef $rm
...
---
name: reverse_order
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r4, $r6
    ; CHECK-LABEL: name: reverse_order
    ; CHECK: REG_SEQUENCE {{.*}}, %subreg.sub_gpr_hi, {{.*}}, %subreg.sub_gpr_lo
    ; CHECK: STVD {{.*}}, 8, {{.*}}
    ; CHECK-NOT: STW
    %0:gprc = COPY $r3
    %1:gprc = COPY $r4
    %2:gprc_nor0 = COPY $r6
    STW %1, 12, %2 :: (store (s32) into %ir.p + 12, align 4)
    STW %0, 8, %2 :: (store (s32) into %ir.p + 8, align 8)
    BLR implicit $lr, implicit undef $rm
...
---
name: interleaved_reg_op
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r4, $r6
    ; CHECK-LABEL: name: interleaved_reg_op
    ; CHECK: REG_SEQUENCE {{.*}}, %subreg.sub_gpr_hi, {{.*}}, %subreg.sub_gpr_lo
    ; CHECK: STVD {{.*}}, 8, {{.*}}
    ; CHECK: LI 7
    ; CHECK-NOT: STW
    %0:gprc = COPY $r3
    %1:gprc = COPY $r4
    %2:gprc_nor0 = COPY $r6
    STW %0, 8, %2 :: (store (s32) into %ir.p + 8, align 8)
    %3:gprc = LI 7
    STW %1, 12, %2 :: (store (s32) into %ir.p + 12, align 4)
    $r3 = COPY %3
    BLR implicit $lr, implicit undef $rm
...
---
name: repeated_zero
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6
    ; CHECK-LABEL: name: repeated_zero
    ; CHECK: REG_SEQUENCE {{.*}}%0, %subreg.sub_gpr_hi, %0, %subreg.sub_gpr_lo
    ; CHECK: STVD {{.*}}, 16, {{.*}}
    ; CHECK: STVD {{.*}}, 8, {{.*}}
    ; CHECK: STVD {{.*}}, 0, {{.*}}
    ; CHECK-NOT: STW
    %0:gprc = LI 0
    %1:gprc_nor0 = COPY $r6
    STW %0, 20, %1 :: (store (s32) into %ir.p + 20, align 4)
    STW %0, 16, %1 :: (store (s32) into %ir.p + 16, align 8)
    STW %0, 12, %1 :: (store (s32) into %ir.p + 12, align 4)
    STW %0, 8, %1 :: (store (s32) into %ir.p + 8, align 8)
    STW %0, 4, %1 :: (store (s32) into %ir.p + 4, align 4)
    STW %0, 0, %1 :: (store (s32) into %ir.p, align 8)
    BLR implicit $lr, implicit undef $rm
...
---
name: single_same_word
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r6
    ; CHECK-LABEL: name: single_same_word
    ; CHECK: STW %0, 8, %1
    ; CHECK: STW %0, 12, %1
    ; CHECK-NOT: STVD
    %0:gprc = LI 0
    %1:gprc_nor0 = COPY $r6
    STW %0, 8, %1 :: (store (s32) into %ir.p + 8, align 8)
    STW %0, 12, %1 :: (store (s32) into %ir.p + 12, align 4)
    BLR implicit $lr, implicit undef $rm
...
