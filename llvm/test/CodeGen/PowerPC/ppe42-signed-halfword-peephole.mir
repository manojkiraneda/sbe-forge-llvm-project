# RUN: llc -mtriple=powerpc-unknown-elf -mcpu=ppe42 -run-pass=ppc-mi-peepholes -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=PPE --implicit-check-not='= LHA'
# RUN: llc -mtriple=powerpc-unknown-elf -mcpu=440 -run-pass=ppc-mi-peepholes -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=PPC

# Legalization alone is insufficient: the generic MI peephole must not fold
# the legal unsigned load and sign extension back into LHA/LHAX on PPE42.
--- |
  define i32 @direct(ptr %p) { ret i32 0 }
  define i32 @indexed(ptr %p, i32 %offset) { ret i32 0 }
...
---
name: direct
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; PPE-LABEL: name: direct
    ; PPE: [[LOAD:%[0-9]+]]:gprc = LHZ
    ; PPE: EXTSH {{(killed )?}}[[LOAD]]
    ; PPC-LABEL: name: direct
    ; PPC: LHA
    ; PPC-NOT: EXTSH
    %0:gprc_nor0 = COPY $r3
    %1:gprc = LHZ 0, %0 :: (load (s16))
    %2:gprc = EXTSH %1
    $r3 = COPY %2
    BLR implicit $lr, implicit undef $rm, implicit $r3
...
---
name: indexed
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r4
    ; PPE-LABEL: name: indexed
    ; PPE: [[LOAD:%[0-9]+]]:gprc = LHZX
    ; PPE: EXTSH {{(killed )?}}[[LOAD]]
    ; PPC-LABEL: name: indexed
    ; PPC: LHAX
    ; PPC-NOT: EXTSH
    %0:gprc_nor0 = COPY $r3
    %1:gprc = COPY $r4
    %2:gprc = LHZX %0, %1 :: (load (s16))
    %3:gprc = EXTSH %2
    $r3 = COPY %3
    BLR implicit $lr, implicit undef $rm, implicit $r3
...
