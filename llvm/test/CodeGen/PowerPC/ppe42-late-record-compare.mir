    liveins: $r3, $r5, $cr0
    ; CHECK-LABEL: name: flags_observed
    ; CHECK: RLWINM 
    ; CHECK: CMPLWI
    ; CHECK: $r4 = LI 9
    $r4 = RLWINM $r3, 0, 28, 29
    $r6 = MFCR implicit $cr0
    $cr0 = CMPLWI $r4, 0
    $r4 = LI 9
    BC $cr0eq, %bb.1
    BLR implicit $lr, implicit undef $rm
  bb.1:
    BLR implicit $lr, implicit undef $rm
