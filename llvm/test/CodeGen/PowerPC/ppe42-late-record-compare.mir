# RUN: llc -mtriple=powerpc-none-eabi -mcpu=ppe42 -run-pass=ppc-branch-select -verify-machineinstrs %s -o %t.mir
# RUN: FileCheck %s < %t.mir
# RUN: llc -mtriple=powerpc-none-eabi -mcpu=ppe42 -start-after=ppc-branch-select -verify-machineinstrs -filetype=obj %t.mir -o %t.o

--- |
  define void @mask_overwritten() { ret void }
  define void @signed_shift() { ret void }
  define void @unsigned_high_mask() { ret void }
  define void @unsigned_sign_live() { ret void }
  define void @flags_observed() { ret void }
  define void @flags_clobbered() { ret void }
  define void @overflow_changed() { ret void }
  define void @existing_record() { ret void }
  define void @signed_arithmetic() { ret void }
...
---
name: mask_overwritten
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r5, $cr0
    ; CHECK-LABEL: name: mask_overwritten
    ; CHECK: RLWINM_rec {{.*}}implicit-def $cr0
    ; CHECK-NOT: CMPLWI
    ; CHECK: $r4 = LI 9
    $r4 = RLWINM $r3, 0, 28, 29
    $cr0 = CMPLWI $r4, 0
    $r4 = LI 9
    BC $cr0eq, %bb.1
    BLR implicit $lr, implicit undef $rm
  bb.1:
    BLR implicit $lr, implicit undef $rm
...
---
name: signed_shift
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r5, $cr0
    ; CHECK-LABEL: name: signed_shift
    ; CHECK: SRW_rec {{.*}}implicit-def $cr0
    ; CHECK-NOT: CMPWI
    ; CHECK: $r4 = LI 9
    $r4 = SRW $r3, $r5
    $cr0 = CMPWI $r4, 0
    $r4 = LI 9
    BC $cr0lt, %bb.1
    BLR implicit $lr, implicit undef $rm
  bb.1:
    BLR implicit $lr, implicit undef $rm
...
---
name: unsigned_high_mask
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r5, $cr0
    ; CHECK-LABEL: name: unsigned_high_mask
    ; CHECK: RLWINM_rec {{.*}}implicit-def $cr0
    ; CHECK-NOT: CMPLWI
    ; CHECK: $r4 = LI 9
    $r4 = RLWINM $r3, 0, 0, 3
    $cr0 = CMPLWI $r4, 0
    $r4 = LI 9
    BC $cr0eq, %bb.1
    BLR implicit $lr, implicit undef $rm
  bb.1:
    BLR implicit $lr, implicit undef $rm
...
---
name: unsigned_sign_live
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r5, $cr0
    ; CHECK-LABEL: name: unsigned_sign_live
    ; CHECK: RLWINM 
    ; CHECK: CMPLWI
    ; CHECK: $r4 = LI 9
    $r4 = RLWINM $r3, 0, 0, 3
    $cr0 = CMPLWI $r4, 0
    $r4 = LI 9
    BC $cr0lt, %bb.1
    BLR implicit $lr, implicit undef $rm
  bb.1:
    BLR implicit $lr, implicit undef $rm
...
---
name: flags_observed
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r5, $cr0
    ; CHECK-LABEL: name: flags_observed
    ; CHECK: RLWINM 
    ; CHECK: CMPLWI
    ; CHECK: $r4 = LI 9
    $r4 = RLWINM $r3, 0, 28, 29
    $r6 = MFCR implicit $cr0
    $cr0 = CMPLWI $r4, 0
    $r4 = LI 9
    BC $cr0eq, %bb.1
    BLR implicit $lr, implicit undef $rm
  bb.1:
    BLR implicit $lr, implicit undef $rm
...
---
name: flags_clobbered
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r5, $cr0
    ; CHECK-LABEL: name: flags_clobbered
    ; CHECK: RLWINM 
    ; CHECK: CMPLWI
    ; CHECK: $r4 = LI 9
    $r4 = RLWINM $r3, 0, 28, 29
    $cr0 = CMPWI $r5, 3
    $cr0 = CMPLWI $r4, 0
    $r4 = LI 9
    BC $cr0eq, %bb.1
    BLR implicit $lr, implicit undef $rm
  bb.1:
    BLR implicit $lr, implicit undef $rm
...
---
name: overflow_changed
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r5, $cr0
    ; CHECK-LABEL: name: overflow_changed
    ; CHECK: RLWINM 
    ; CHECK: CMPLWI
    ; CHECK: $r4 = LI 9
    $r4 = RLWINM $r3, 0, 28, 29
    MTSPR 1, $r5, implicit-def $xer
    $cr0 = CMPLWI $r4, 0
    $r4 = LI 9
    BC $cr0eq, %bb.1
    BLR implicit $lr, implicit undef $rm
  bb.1:
    BLR implicit $lr, implicit undef $rm
...
---
name: existing_record
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r5, $cr0
    ; CHECK-LABEL: name: existing_record
    ; CHECK: ANDI_rec {{.*}}implicit-def $cr0
    ; CHECK-NOT: CMPLWI
    ; CHECK: $r4 = LI 9
    $r4 = ANDI_rec $r3, 12, implicit-def dead $cr0
    $r6 = LI 5
    $cr0 = CMPLWI $r4, 0
    $r4 = LI 9
    BC $cr0eq, %bb.1
    BLR implicit $lr, implicit undef $rm
  bb.1:
    BLR implicit $lr, implicit undef $rm
...
---
name: signed_arithmetic
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r5, $cr0
    ; CHECK-LABEL: name: signed_arithmetic
    ; CHECK: ADD4_rec {{.*}}implicit-def $cr0
    ; CHECK-NOT: CMPWI
    ; CHECK: $r4 = LI 9
    $r4 = ADD4 $r3, $r5
    $cr0 = CMPWI $r4, 0
    $r4 = LI 9
    BC $cr0lt, %bb.1
    BLR implicit $lr, implicit undef $rm
  bb.1:
    BLR implicit $lr, implicit undef $rm
...
