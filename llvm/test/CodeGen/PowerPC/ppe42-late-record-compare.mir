# RUN: llc -mtriple=powerpc-none-eabi -mcpu=ppe42 -run-pass=ppc-branch-select -verify-machineinstrs %s -o %t.mir
# RUN: FileCheck %s < %t.mir
# RUN: llc -mtriple=powerpc-none-eabi -mcpu=ppe42 -start-after=ppc-branch-select -verify-machineinstrs -filetype=obj %t.mir -o %t.o

--- |
  define void @mask_overwritten() { ret void }
  define void @signed_shift() { ret void }
  define void @unsigned_high_mask() { ret void }
  define void @unsigned_sign_live() { ret void }
  define void @flags_observed() { ret void }
  define void @flags_clobbered() { ret void }
  define void @overflow_changed() { ret void }
  define void @existing_record() { ret void }
  define void @signed_arithmetic() { ret void }
  define void @record_and() { ret void }
  define void @record_andc() { ret void }
  define void @record_or() { ret void }
  define void @record_orc() { ret void }
  define void @record_xor() { ret void }
  define void @record_eqv() { ret void }
  define void @record_nand() { ret void }
  define void @record_nor() { ret void }
  define void @record_subf() { ret void }
  define void @record_neg() { ret void }
  define void @record_slw() { ret void }
  define void @record_sraw() { ret void }
  define void @record_srawi() { ret void }
  define void @record_cntlzw() { ret void }
  define void @record_extsb() { ret void }
  define void @record_rlwnm() { ret void }
...
---
name: mask_overwritten
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r5, $cr0
    ; CHECK-LABEL: name: mask_overwritten
    ; CHECK: RLWINM_rec {{.*}}implicit-def $cr0
    ; CHECK-NOT: CMPLWI
    ; CHECK: $r4 = LI 9
    $r4 = RLWINM $r3, 0, 28, 29
    $cr0 = CMPLWI $r4, 0
    $r4 = LI 9
    BC $cr0eq, %bb.1
    BLR implicit $lr, implicit undef $rm
  bb.1:
    BLR implicit $lr, implicit undef $rm
...
---
name: signed_shift
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r5, $cr0
    ; CHECK-LABEL: name: signed_shift
    ; CHECK: SRW_rec {{.*}}implicit-def $cr0
    ; CHECK-NOT: CMPWI
    ; CHECK: $r4 = LI 9
    $r4 = SRW $r3, $r5
    $cr0 = CMPWI $r4, 0
    $r4 = LI 9
    BC $cr0lt, %bb.1
    BLR implicit $lr, implicit undef $rm
  bb.1:
    BLR implicit $lr, implicit undef $rm
...
