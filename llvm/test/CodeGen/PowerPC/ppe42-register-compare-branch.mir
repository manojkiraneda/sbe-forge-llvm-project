# RUN: llc -mtriple=powerpc-unknown-elf -mcpu=ppe42 -run-pass=ppc-branch-select -verify-machineinstrs %s -o - | FileCheck %s

--- |
  define void @unsigned_gt() { ret void }
  define void @signed_eq() { ret void }
  define void @unsigned_bit_eq() { ret void }
  define void @other_cr_field() { ret void }
...
---
name: unsigned_gt
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r5, $r4
    ; CHECK-LABEL: name: unsigned_gt
    ; CHECK: CMPLWBC 1, 1, killed $r5, killed $r4, %bb.1
    ; CHECK-NOT: CMPLW
    ; CHECK-NOT: BCC
    $cr0 = CMPLW killed $r5, killed $r4
    BCC 44, killed $cr0, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: signed_eq
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r4
    ; CHECK-LABEL: name: signed_eq
    ; CHECK: CMPWBC 1, 2, killed $r3, killed $r4, %bb.1
    $cr0 = CMPW killed $r3, killed $r4
    BCC 76, killed $cr0, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: unsigned_bit_eq
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r4
    ; CHECK-LABEL: name: unsigned_bit_eq
    ; CHECK: CMPLWBC 1, 2, killed $r3, killed $r4, %bb.1
    $cr0 = CMPLW killed $r3, killed $r4
    BC killed $cr0eq, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: other_cr_field
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r4
    ; CHECK-LABEL: name: other_cr_field
    ; CHECK: $cr1 = CMPLW
    ; CHECK: BCC
    $cr1 = CMPLW killed $r3, killed $r4
    BCC 44, killed $cr1, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
