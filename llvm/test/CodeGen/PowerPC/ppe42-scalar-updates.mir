---
name: encoded_negative
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r4
    ; CHECK-LABEL: name: encoded_negative
    ; CHECK-NOT: ADDI
    ; CHECK: LWZU {{.*}}-4, {{(killed )?}}$r3
    ; CHECK-NOT: ADDI
    $r3 = ADDI $r3, 65532
    $r4 = LWZ 0, $r3 :: (load (s32) from %ir.p)
    BLR implicit $lr, implicit undef $rm
...
---
name: volatile_access
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r4
    ; CHECK-LABEL: name: volatile_access
    ; CHECK: LWZ 
    ; CHECK: ADDI
    $r4 = LWZ 4, $r3 :: (volatile load (s32) from %ir.p)
    $r3 = ADDI $r3, 4
    BLR implicit $lr, implicit undef $rm
...
---
name: overlap
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r4
    ; CHECK-LABEL: name: overlap
    ; CHECK: LWZ 
    ; CHECK: ADDI
    $r3 = LWZ 4, $r3 :: (load (s32) from %ir.p)
    $r3 = ADDI $r3, 4
    BLR implicit $lr, implicit undef $rm
...
---
name: different_address
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r4
    ; CHECK-LABEL: name: different_address
    ; CHECK: STW 
    ; CHECK: ADDI
    STW $r4, 8, $r3 :: (store (s32) into %ir.p)
    $r3 = ADDI $r3, 4
    BLR implicit $lr, implicit undef $rm
...
