# RUN: llc -mtriple=powerpc-unknown-elf -mcpu=ppe42 -run-pass=ppc-branch-select -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=powerpc-unknown-elf -mcpu=ppe42 -O=2 %S/ppe42-wide-boundary-compare.ll -o - | FileCheck %S/ppe42-wide-boundary-compare.ll
# RUN: llc -mtriple=powerpc-unknown-elf -mcpu=ppe42 -run-pass=ppc-branch-select -verify-machineinstrs %S/ppe42-register-compare-branch.mir -o - | FileCheck %S/ppe42-register-compare-branch.mir

--- |
  define void @signed_eq() { ret void }
  define void @bit_eq() { ret void }
  define void @bit_ne() { ret void }
  define void @bit_other_condition() { ret void }
  define void @signed_ne() { ret void }
  define void @signed_gt() { ret void }
  define void @unsigned_eq() { ret void }
  define void @unsigned_gt() { ret void }
  define void @negative_immediate() { ret void }
  define void @live_condition() { ret void }
  define void @inline_asm_elsewhere() { ret void }
  define void @inline_asm_in_range() { ret void }
  define void @fixed_asm_in_range() { ret void }
  define void @asm_before_branch() { ret void }
  define void @asm_after_target() { ret void }
  define void @fixed_tw_asm_in_range() { ret void }
...
---
name: signed_eq
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: signed_eq
    ; CHECK: CMPWIBC 1, 2, killed $r3, 7, %bb.1
    ; CHECK-NEXT: BLR
    $cr0 = CMPWI killed $r3, 7
    BCC 76, killed $cr0, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: bit_eq
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: bit_eq
    ; CHECK: CMPWIBC 1, 2, killed $r3, 0, %bb.1
    ; CHECK-NOT: CMPLWI
    ; CHECK-NOT: BC
    $cr0 = CMPLWI killed $r3, 0
    BC killed $cr0eq, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: bit_ne
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: bit_ne
    ; CHECK: CMPWIBC 0, 2, killed $r3, 0, %bb.1
    ; CHECK-NOT: CMPLWI
    ; CHECK-NOT: BCn
    $cr0 = CMPLWI killed $r3, 0
    BCn killed $cr0eq, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: bit_other_condition
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: bit_other_condition
    ; CHECK: CMPLWI killed $r3, 0
    ; CHECK: BC $cr0lt, %bb.1
    $cr0 = CMPLWI killed $r3, 0
    BC $cr0lt, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: signed_ne
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: signed_ne
    ; CHECK: CMPWIBC 0, 2, killed $r3, 3, %bb.1
    $cr0 = CMPWI killed $r3, 3
    BCC 68, killed $cr0, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: signed_gt
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: signed_gt
    ; CHECK: CMPWIBC 1, 1, killed $r3, 9, %bb.1
    $cr0 = CMPWI killed $r3, 9
    BCC 44, killed $cr0, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: unsigned_eq
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: unsigned_eq
    ; CHECK: CMPWIBC 1, 2, killed $r3, 31, %bb.1
    $cr0 = CMPLWI killed $r3, 31
    BCC 76, killed $cr0, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: unsigned_gt
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: unsigned_gt
    ; CHECK: CMPLWI
    ; CHECK: BCC
    $cr0 = CMPLWI killed $r3, 9
    BCC 44, killed $cr0, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: negative_immediate
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: negative_immediate
    ; CHECK: CMPWI
    ; CHECK: BCC
    $cr0 = CMPWI killed $r3, -1
    BCC 76, killed $cr0, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: live_condition
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: live_condition
    ; CMPWIBC sets CR0 just like CMPWI, so CR0 can remain live after folding.
    ; CHECK: CMPWIBC 1, 2, killed $r3, 4, %bb.1
    ; CHECK-NOT: CMPWI
    ; CHECK-NOT: BCC
    $cr0 = CMPWI killed $r3, 4
    BCC 76, $cr0, %bb.1
    BLR implicit $lr, implicit $rm, implicit killed $cr0
  bb.1:
    liveins: $cr0
    BLR implicit $lr, implicit $rm, implicit killed $cr0
...
---
name: inline_asm_elsewhere
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: inline_asm_elsewhere
    ; CHECK: CMPWIBC 1, 2, killed $r3, 7, %bb.1
    $cr0 = CMPWI killed $r3, 7
    BCC 76, killed $cr0, %bb.1
  bb.1:
    BLR implicit $lr, implicit $rm
  bb.2:
    INLINEASM &"nop", 1
    BLR implicit $lr, implicit $rm
...
---
name: inline_asm_in_range
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: inline_asm_in_range
    ; CHECK: CMPWI killed $r3, 7
    ; CHECK: BCC 76, killed $cr0, %bb.2
    $cr0 = CMPWI killed $r3, 7
    BCC 76, killed $cr0, %bb.2
  bb.1:
    INLINEASM &".space 16", 1
    BLR implicit $lr, implicit $rm
  bb.2:
    BLR implicit $lr, implicit $rm
...
---
name: fixed_asm_in_range
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: fixed_asm_in_range
    ; CHECK: CMPWIBC 1, 2, killed $r3, 0, %bb.2
    $cr0 = CMPLWI killed $r3, 0
    BCC 76, killed $cr0, %bb.2
  bb.1:
    INLINEASM &"trap", 1
    BLR implicit $lr, implicit $rm
  bb.2:
    BLR implicit $lr, implicit $rm
...
---
name: asm_before_branch
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: asm_before_branch
    ; CHECK: CMPWIBC 1, 2, killed $r3, 0, %bb.1
    INLINEASM &".space 16", 1
    $cr0 = CMPLWI killed $r3, 0
    BCC 76, killed $cr0, %bb.1
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: asm_after_target
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: asm_after_target
    ; CHECK: CMPWIBC 1, 2, killed $r3, 0, %bb.1
    $cr0 = CMPLWI killed $r3, 0
    BCC 76, killed $cr0, %bb.1
  bb.1:
    INLINEASM &".space 16", 1
    BLR implicit $lr, implicit $rm
...
---
name: fixed_tw_asm_in_range
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: fixed_tw_asm_in_range
    ; CHECK: CMPWIBC 1, 2, killed $r3, 0, %bb.2
    $cr0 = CMPLWI killed $r3, 0
    BCC 76, killed $cr0, %bb.2
  bb.1:
    INLINEASM &"tw 31, $0, $1", 9, 13, 4, 13, 6
    BLR implicit $lr, implicit $rm
  bb.2:
    BLR implicit $lr, implicit $rm
...
