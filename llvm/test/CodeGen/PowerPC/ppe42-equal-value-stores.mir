name: unknown_definition
tracksRegLiveness: true
frameInfo:
  hasCalls: true
  adjustsStack: true
body: |
  bb.0:
    liveins: $r1, $r3, $r4, $r13
    ; CHECK-LABEL: name: unknown_definition
    ; CHECK-NOT: STVD
    ; CHECK: STW
    ; CHECK: STW
    ; CHECK-NOT: STVD
    $r4 = LI 0
    $r5 = LWZ 8, $r3 :: (load (s32) from @g + 8)
    STW $r4, 0, $r3 :: (store (s32) into @g, align 8)
    STW $r4, 4, $r3 :: (store (s32) into @g + 4, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
name: call_barrier
tracksRegLiveness: true
frameInfo:
  hasCalls: true
  adjustsStack: true
body: |
  bb.0:
    liveins: $r1, $r3, $r4, $r13
    ; CHECK-LABEL: name: call_barrier
    ; CHECK-NOT: STVD
    ; CHECK: STW
    ; CHECK: STW
    ; CHECK-NOT: STVD
    $r4 = LI 0
    $r5 = LI 0
    BL @callee, csr_svr432, implicit-def dead $lr, implicit undef $rm, implicit-def $r4, implicit-def $r3
    STW $r4, 0, $r3 :: (store (s32) into @g, align 8)
    STW $r4, 4, $r3 :: (store (s32) into @g + 4, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
