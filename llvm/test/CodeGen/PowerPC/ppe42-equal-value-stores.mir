# RUN: llc -mtriple=powerpc-none-eabi -mcpu=ppe42 -run-pass=ppc-pre-emit-peephole -verify-machineinstrs %s -o %t.mir
# RUN: FileCheck %s < %t.mir
# RUN: llc -mtriple=powerpc-none-eabi -mcpu=ppe42 -start-after=ppc-pre-emit-peephole -verify-machineinstrs -filetype=obj %t.mir -o %t.o

--- |
  @g = external global [4 x i32], align 8
  declare void @callee()
  define void @equal_zero() { ret void }
  define void @equal_nonzero() { ret void }
  define void @equal_lis() { ret void }
  define void @mixed_zero() { ret void }
  define void @copy_neighbour() { ret void }
  define void @copy_livein() { ret void }
  define void @source_is_low() { ret void }
  define void @reverse_stores() { ret void }
  define void @dead_neighbour() { ret void }
  define void @different_constants() { ret void }
  define void @different_lis() { ret void }
  define void @neighbour_clobbered() { ret void }
  define void @unknown_neighbour() { ret void }
  define void @unknown_definition() { ret void }
  define void @call_barrier() { ret void }
  define void @budget() { ret void }
  define void @volatile() { ret void }
  define void @word_aligned() { ret void }
  define void @source_changed_between() { ret void }
  define void @neighbour_changed_between() { ret void }
  define void @cached_sda_zero() { ret void }
  define void @stack_word_mmos() { ret void }
  define void @undef_copy() { ret void }
  define void @alias_clobber() { ret void }
  define void @nonadjacent() { ret void }
  define void @atomic() { ret void }
...
---
name: equal_zero
tracksRegLiveness: true
frameInfo:
  hasCalls: true
  adjustsStack: true
body: |
  bb.0:
    liveins: $r1, $r3, $r4, $r13
    ; CHECK-LABEL: name: equal_zero
    ; CHECK-NOT: STW
    ; CHECK: STVD {{(killed )?}}$r4_r5, 0, $r3
    ; CHECK-NOT: STW
    $r4 = LI 0
    $r5 = LI 0
    STW $r4, 0, $r3 :: (store (s32) into @g, align 8)
    STW $r4, 4, $r3 :: (store (s32) into @g + 4, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
name: equal_nonzero
tracksRegLiveness: true
frameInfo:
  hasCalls: true
  adjustsStack: true
body: |
  bb.0:
    liveins: $r1, $r3, $r4, $r13
    ; CHECK-LABEL: name: equal_nonzero
    ; CHECK-NOT: STW
    ; CHECK: STVD {{(killed )?}}$r4_r5, 0, $r3
    ; CHECK-NOT: STW
    $r4 = LI -7
    $r5 = LI -7
    STW $r4, 0, $r3 :: (store (s32) into @g, align 8)
    STW $r4, 4, $r3 :: (store (s32) into @g + 4, align 4)
    BLR implicit $lr, implicit undef $rm
...
---
