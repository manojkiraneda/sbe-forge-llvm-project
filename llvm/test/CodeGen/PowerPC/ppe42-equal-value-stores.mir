    $r5 = LI 0
    STW $r4, 0, $r3 :: (volatile store (s32) into @g, align 8)
    STW $r4, 4, $r3 :: (volatile store (s32) into @g + 4, align 4)
    BLR implicit $lr, implicit undef $rm
...
