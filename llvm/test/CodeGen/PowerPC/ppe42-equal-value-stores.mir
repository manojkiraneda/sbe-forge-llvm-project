---
name: cached_sda_zero
tracksRegLiveness: true
frameInfo:
  hasCalls: true
  adjustsStack: true
body: |
  bb.0:
    liveins: $r1, $r3, $r4, $r13
    ; CHECK-LABEL: name: cached_sda_zero
    ; CHECK-NOT: STW
    ; CHECK: STVD {{(killed )?}}$r4_r5, target-flags(ppc-sda21) @g, $r13
    ; CHECK-NOT: STW
    $r4 = LI 0
    $r5 = LI 0
    $r31 = LA $r13, target-flags(ppc-sda21) @g
    STW $r4, 4, $r31 :: (store (s32) into @g + 4, align 4)
    STW $r4, target-flags(ppc-sda21) @g, $r13 :: (store (s32) into @g, align 8)
    BLR implicit $lr, implicit undef $rm
...
---
name: stack_word_mmos
tracksRegLiveness: true
frameInfo:
  hasCalls: true
  adjustsStack: true
body: |
  bb.0:
    liveins: $r1, $r3, $r4, $r13
    ; CHECK-LABEL: name: stack_word_mmos
    ; CHECK-NOT: STW
    ; CHECK: STVD {{(killed )?}}$r4_r5, 8, $r1
    ; CHECK-NOT: STW
    $r4 = LI 0
    $r5 = LI 0
    STW $r4, 12, $r1 :: (store (s32), align 4)
    STW $r4, 8, $r1 :: (store (s32), align 4)
    BLR implicit $lr, implicit undef $rm
...
---
name: undef_copy
tracksRegLiveness: true
frameInfo:
  hasCalls: true
  adjustsStack: true
body: |
