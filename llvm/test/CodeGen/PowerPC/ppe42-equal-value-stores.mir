    $r5 = LI 0
    STW $r4, 0, $r3 :: (store (s32) into @g, align 8)
    STW $r4, 8, $r3 :: (store (s32) into @g + 8, align 8)
    BLR implicit $lr, implicit undef $rm
...
---
name: atomic
tracksRegLiveness: true
frameInfo:
  hasCalls: true
  adjustsStack: true
body: |
