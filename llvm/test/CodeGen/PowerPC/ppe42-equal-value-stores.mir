    liveins: $r1, $r3, $r4, $r13
    ; CHECK-LABEL: name: budget
    ; CHECK-NOT: STVD
    ; CHECK: STW
    ; CHECK: STW
    ; CHECK-NOT: STVD
    $r4 = LI 0
    $r5 = LI 0
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    NOP
    STW $r4, 0, $r3 :: (store (s32) into @g, align 8)
    STW $r4, 4, $r3 :: (store (s32) into @g + 4, align 4)
    BLR implicit $lr, implicit undef $rm
...
