# RUN: llc -mtriple=powerpc-unknown-elf -mcpu=ppe42 -verify-machineinstrs %S/ppe42-bit-test-context.ll -o - | FileCheck %S/ppe42-bit-test-context.ll
# RUN: opt -passes=debugify %S/ppe42-bit-test-context.ll -o %t.bc
# RUN: llc -mtriple=powerpc-unknown-elf -mcpu=ppe42 -verify-machineinstrs %t.bc -o - | FileCheck %S/ppe42-bit-test-context.ll
# RUN: llc -mtriple=powerpc-unknown-elf -mcpu=ppe42 -run-pass=ppc-branch-select -verify-machineinstrs %s -o - | FileCheck %s
# PPE42 can replace a single-bit mask, zero comparison, and branch with one
# fused instruction. Keep the mask when its result is live; the remaining
# zero comparison and branch can still use CMPWIBC.
--- |
  define void @bit_clear() { ret void }
  define void @bit_set() { ret void }
  define void @result_live() { ret void }
  define void @bit_clear_across_trap() { ret void }
  define void @direct_eq() { ret void }
  define void @direct_ne_rotated() { ret void }
  define void @scheduled_debug() { ret void }
  define void @in_place_mask() { ret void }
  define void @source_clobbered() { ret void }
  define void @mask_observed() { ret void }
  define void @source_used_between() { ret void }
  define void @cr_still_live() { ret void }
  define void @other_condition_bit() { ret void }
  define void @multiple_mask_bits() { ret void }
...
---
name: bit_clear
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: bit_clear
    ; CHECK: BNBWI 1, killed $r3, 4, %bb.1
    ; CHECK-NOT: RLWINM
    ; CHECK-NOT: CMPLWI
    $r4 = RLWINM killed $r3, 0, 4, 4
    $cr0 = CMPLWI killed $r4, 0
    BCC 76, killed $cr0, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: bit_set
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: bit_set
    ; CHECK: BNBWI 0, killed $r3, 4, %bb.1
    $r4 = RLWINM killed $r3, 0, 4, 4
    $cr0 = CMPLWI killed $r4, 0
    BCC 68, killed $cr0, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: result_live
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: result_live
    ; CHECK: RLWINM
    ; CHECK: CMPWIBC 1, 2, $r4, 0, %bb.1
    ; CHECK-NOT: BNBWI
    $r4 = RLWINM killed $r3, 0, 4, 4
    $cr0 = CMPLWI $r4, 0
    BCC 76, killed $cr0, %bb.1
    BLR implicit $lr, implicit $rm, implicit killed $r4
  bb.1:
    liveins: $r4
    BLR implicit $lr, implicit $rm, implicit killed $r4
...
---
name: bit_clear_across_trap
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: bit_clear_across_trap
    ; CHECK: BNBWI 1, killed $r3, 4, %bb.2
    $r4 = RLWINM killed $r3, 0, 4, 4
    $cr0 = CMPLWI killed $r4, 0
    BCC 76, killed $cr0, %bb.2
  bb.1:
    INLINEASM &"trap", 1
    BLR implicit $lr, implicit $rm
  bb.2:
    BLR implicit $lr, implicit $rm
...
---
name: direct_eq
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: direct_eq
    ; CHECK: BNBWI 1, killed $r3, 11, %bb.1
    $r4 = RLWINM $r3, 0, 11, 11
    $cr0 = CMPLWI $r4, 0
    BC $cr0eq, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: direct_ne_rotated
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: direct_ne_rotated
    ; CHECK: BNBWI 0, killed $r3, 4, %bb.1
    $r4 = RLWINM $r3, 7, 29, 29
    $cr0 = CMPWI $r4, 0
    BCn $cr0eq, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: scheduled_debug
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: scheduled_debug
    ; CHECK: $r5 = LI 17
    ; CHECK: $r6 = LI 23
    ; CHECK: BNBWI 1, killed $r3, 24, %bb.1
    $r4 = RLWINM $r3, 0, 24, 24
    DBG_VALUE $r4, $noreg
    $r5 = LI 17
    $cr0 = CMPLWI $r4, 0
    DBG_VALUE $r4, $noreg
    $r6 = LI 23
    BC $cr0eq, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: in_place_mask
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: in_place_mask
    ; CHECK: BNBWI 0, killed $r3, 20, %bb.1
    $r3 = RLWINM $r3, 0, 20, 20
    $cr0 = CMPLWI $r3, 0
    BCn $cr0eq, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: source_clobbered
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: source_clobbered
    ; CHECK: RLWINM
    ; CHECK: $r3 = LI 0
    ; CHECK: CMPWIBC 1, 2, $r4, 0, %bb.1
    $r4 = RLWINM $r3, 0, 11, 11
    $r3 = LI 0
    $cr0 = CMPLWI $r4, 0
    BC $cr0eq, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: mask_observed
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r5
    ; CHECK-LABEL: name: mask_observed
    ; CHECK: RLWINM
    ; CHECK: STW
    ; CHECK: CMPWIBC 1, 2, $r4, 0, %bb.1
    $r4 = RLWINM $r3, 0, 11, 11
    STW $r4, 0, $r5
    $cr0 = CMPLWI $r4, 0
    BC $cr0eq, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: source_used_between
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3, $r5
    ; CHECK-LABEL: name: source_used_between
    ; CHECK: RLWINM
    ; CHECK: STW
    ; CHECK: CMPWIBC 1, 2, $r4, 0, %bb.1
    $r4 = RLWINM $r3, 0, 11, 11
    STW $r3, 0, $r5
    $cr0 = CMPLWI $r4, 0
    BC $cr0eq, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: cr_still_live
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: cr_still_live
    ; CHECK: RLWINM
    ; CHECK: CMPLWI
    ; CHECK: BC $cr0eq, %bb.1
    $r4 = RLWINM $r3, 0, 11, 11
    $cr0 = CMPLWI $r4, 0
    BC $cr0eq, %bb.1
    BLR implicit $lr, implicit $rm, implicit $cr0lt
  bb.1:
    liveins: $cr0lt
    BLR implicit $lr, implicit $rm, implicit $cr0lt
...
---
name: other_condition_bit
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: other_condition_bit
    ; CHECK: RLWINM
    ; CHECK: CMPWIBC 0, 2, $r4, 0, %bb.1
    $r4 = RLWINM $r3, 0, 11, 11
    $cr0 = CMPLWI $r4, 0
    BC $cr0gt, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: multiple_mask_bits
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: multiple_mask_bits
    ; CHECK: RLWINM
    ; CHECK: CMPWIBC 1, 2, $r4, 0, %bb.1
    $r4 = RLWINM $r3, 0, 11, 12
    $cr0 = CMPLWI $r4, 0
    BC $cr0eq, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
