# RUN: llc -mtriple=powerpc-unknown-elf -mcpu=ppe42 -run-pass=ppc-branch-select -verify-machineinstrs %s -o - | FileCheck %s
# PPE42 can replace a single-bit mask, zero comparison, and branch with one
# fused instruction. Keep the mask when its result is live; the remaining
# zero comparison and branch can still use CMPWIBC.
--- |
  define void @bit_clear() { ret void }
  define void @bit_set() { ret void }
  define void @result_live() { ret void }
  define void @bit_clear_across_trap() { ret void }
...
---
name: bit_clear
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: bit_clear
    ; CHECK: BNBWI 1, killed $r3, 4, %bb.1
    ; CHECK-NOT: RLWINM
    ; CHECK-NOT: CMPLWI
    $r4 = RLWINM killed $r3, 0, 4, 4
    $cr0 = CMPLWI killed $r4, 0
    BCC 76, killed $cr0, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: bit_set
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: bit_set
    ; CHECK: BNBWI 0, killed $r3, 4, %bb.1
    $r4 = RLWINM killed $r3, 0, 4, 4
    $cr0 = CMPLWI killed $r4, 0
    BCC 68, killed $cr0, %bb.1
    BLR implicit $lr, implicit $rm
  bb.1:
    BLR implicit $lr, implicit $rm
...
---
name: result_live
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: result_live
    ; CHECK: RLWINM
    ; CHECK: CMPWIBC 1, 2, $r4, 0, %bb.1
    ; CHECK-NOT: BNBWI
    $r4 = RLWINM killed $r3, 0, 4, 4
    $cr0 = CMPLWI $r4, 0
    BCC 76, killed $cr0, %bb.1
    BLR implicit $lr, implicit $rm, implicit killed $r4
  bb.1:
    liveins: $r4
    BLR implicit $lr, implicit $rm, implicit killed $r4
...
---
name: bit_clear_across_trap
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r3
    ; CHECK-LABEL: name: bit_clear_across_trap
    ; CHECK: BNBWI 1, killed $r3, 4, %bb.2
    $r4 = RLWINM killed $r3, 0, 4, 4
    $cr0 = CMPLWI killed $r4, 0
    BCC 76, killed $cr0, %bb.2
  bb.1:
    INLINEASM &"trap", 1
    BLR implicit $lr, implicit $rm
  bb.2:
    BLR implicit $lr, implicit $rm
...
